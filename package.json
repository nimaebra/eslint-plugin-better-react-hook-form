{
  "name": "eslint-plugin-better-react-hook-form",
  "version": "0.1.0",
  "description": "ESLint rules for safer, more maintainable React Hook Form usage.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "react-hook-form",
    "react",
    "forms"
  ],
  "homepage": "https://github.com/nimaebra/eslint-plugin-better-react-hook-form#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimaebra/eslint-plugin-better-react-hook-form.git"
  },
  "license": "MIT",
  "author": "Nima Ebrazeh",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.28.9",
  "dependencies": {
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/utils": "^8.72.0"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "branch:check": "validate-branch-name",
    "changeset": "changeset",
    "configs:check": "tsx scripts/configs.ts --check",
    "commitlint": "commitlint",
    "conventions:check": "pnpm branch:check && pnpm commitlint --from origin/main --to HEAD --verbose",
    "docs": "pnpm docs:build",
    "docs:build": "pnpm build && eslint-doc-generator && tsx scripts/configs.ts",
    "docs:check": "eslint-doc-generator --check && tsx scripts/configs.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "husky",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "pack:dry-run": "pnpm pack:check",
    "prepublishOnly": "pnpm security:audit && pnpm check && pnpm smoke:pack",
    "release:publish": "changeset publish",
    "security:audit": "pnpm audit --audit-level=moderate",
    "smoke:pack": "tsx scripts/smoke-pack.ts",
    "test": "vitest run tests/rules tests/configs tests/utils",
    "test:coverage": "vitest run tests/rules tests/configs tests/utils --coverage",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm build && pnpm test:integration && pnpm docs:check && pnpm pack:check",
    "version-packages": "changeset version"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "react-hook-form": ">=7.55.0 <8"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript-eslint/rule-tester": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-doc-generator": "^3.7.1",
    "eslint-plugin-eslint-plugin": "^7.2.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "validate-branch-name": "^1.3.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "bugs": {
    "url": "https://github.com/nimaebra/eslint-plugin-better-react-hook-form/issues"
  },
  "sideEffects": false,
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  }
}
